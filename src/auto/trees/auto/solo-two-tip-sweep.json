{
 "kind": "bt.tree",
 "id": "solo-two-tip-sweep",
 "name": "Solo: two TIPS, sweep, and PARK",
 "env": "onboard",
 "description": "Two TIPS from the pre-loads and the two own-side FLOWERS, then blind sweeps of the spill to fill the hopper, and a PARK.",
 "meta": {
  "start": "any"
 },
 "defs": {
  "len": "bots.me.dimensions.length",
  "flip": "if(bots.me.shooter.facing == 'front', 180, 0)",
  "hiveX": "-0.3237",
  "stand": "len / 2 + field.flowerHalfSize + 0.02",
  "launchAudience": "pose(hiveX, -1.32, -90 + flip)",
  "launchRear": "pose(hiveX, 1.32, 90 + flip)",
  "ownFlower": "pose(-1.7282 + stand, -0.5942, 180)",
  "rearFlower": "pose(-0.5942, 1.7282 - stand, 90)",
  "park": "pose(-(field.half - len / 2 - 0.09), 0.8954, 180)"
 },
 "root": {
  "sequence": {
   "children": [
    {
     "id": "steps",
     "parallel": {
      "policy": "any",
      "children": [
       {
        "id": "finish",
        "note": "When the clock shows 3.5 s, the last step starts, whatever step is running then.",
        "ref": "auto.clockAtMost",
        "params": {
         "sec": 3.5
        }
       },
       {
        "sequence": {
         "children": [
          {
           "id": "s1",
           "ref": "drive.driveTo",
           "params": {
            "pose": "launchAudience",
            "timeoutSec": 4
           }
          },
          {
           "id": "s2",
           "note": "The raised CELL starts with 3 NECTAR, so the third POLLEN tips the HIVE. The fourth stays for the next CELL.",
           "ref": "shooter.shoot",
           "params": {
            "count": 3,
            "timeoutSec": 2.5
           }
          },
          {
           "id": "s3",
           "ref": "drive.driveTo",
           "params": {
            "pose": "offset(ownFlower, 0.2, 0)",
            "timeoutSec": 3.5
           }
          },
          {
           "id": "collect-s4",
           "parallel": {
            "policy": "any",
            "children": [
             {
              "ref": "intake.run",
              "params": {
               "filter": "pollen"
              }
             },
             {
              "sequence": {
               "children": [
                {
                 "id": "s4",
                 "ref": "drive.driveTo",
                 "params": {
                  "pose": "ownFlower",
                  "timeoutSec": 1.5
                 }
                },
                {
                 "id": "full-s5",
                 "parallel": {
                  "policy": "any",
                  "children": [
                   {
                    "ref": "auto.waitHopperFull"
                   },
                   {
                    "id": "s5",
                    "ref": "drive.push",
                    "params": {
                     "power": 0.35,
                     "timeoutSec": 2.2
                    }
                   }
                  ]
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "id": "s6",
           "ref": "drive.driveTo",
           "params": {
            "pose": "launchRear",
            "timeoutSec": 5
           }
          },
          {
           "id": "s7",
           "ref": "shooter.shoot",
           "params": {
            "count": 4,
            "timeoutSec": 4,
            "cell": "rear"
           }
          },
          {
           "id": "s8",
           "ref": "drive.driveTo",
           "params": {
            "pose": "offset(rearFlower, 0, -0.2)",
            "timeoutSec": 3
           }
          },
          {
           "id": "collect-s9",
           "parallel": {
            "policy": "any",
            "children": [
             {
              "ref": "intake.run",
              "params": {
               "filter": "pollen"
              }
             },
             {
              "sequence": {
               "children": [
                {
                 "id": "s9",
                 "ref": "drive.driveTo",
                 "params": {
                  "pose": "rearFlower",
                  "timeoutSec": 1.5
                 }
                },
                {
                 "id": "full-s10",
                 "parallel": {
                  "policy": "any",
                  "children": [
                   {
                    "ref": "auto.waitHopperFull"
                   },
                   {
                    "id": "s10",
                    "ref": "drive.push",
                    "params": {
                     "power": 0.35,
                     "timeoutSec": 2.2
                    }
                   }
                  ]
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "id": "s11",
           "ref": "drive.driveTo",
           "params": {
            "pose": "launchRear",
            "timeoutSec": 3
           }
          },
          {
           "id": "s12",
           "ref": "shooter.shoot",
           "params": {
            "count": 4,
            "timeoutSec": 3
           }
          },
          {
           "id": "s13",
           "note": "From the rear launch spot the camera can't see the audience CELL, so the robot can't watch the TIP finish. It waits 1.5 s for the spill to land instead.",
           "ref": "auto.wait",
           "params": {
            "timeoutSec": 1.5
           }
          },
          {
           "id": "collect-s14",
           "parallel": {
            "policy": "any",
            "children": [
             {
              "ref": "auto.waitHopperFull"
             },
             {
              "ref": "intake.run",
              "params": {
               "filter": "all"
              }
             },
             {
              "id": "s14",
              "note": "A blind sweep: a TIP spills the CELL where the robot can't see. scripts/plan-sweeps.ts records where the spill comes to rest over many simulated matches and writes the lanes that collect the most. The path ends early once the hopper is full.",
              "ref": "drive.followPath",
              "params": {
               "waypoints": [
                {
                 "x": -0.515,
                 "y": 0.965,
                 "headingDeg": null
                },
                {
                 "x": -1.565,
                 "y": 0.965,
                 "headingDeg": null
                }
               ],
               "timeoutSec": 3.8,
               "tag": "sweep-solo"
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    },
    {
     "id": "collect-s15",
     "parallel": {
      "policy": "any",
      "children": [
       {
        "ref": "intake.run",
        "params": {
         "filter": "all"
        }
       },
       {
        "id": "s15",
        "note": "Every drive to PARK runs the intake: the robot faces the alliance wall, where NECTAR from the LOADING ZONE collects, and a full hopper at the end of AUTO is a head start in TELEOP. LEAVE needs the robot clear of the wall by half its size plus 2 cm. The pose is 9 cm off the wall, which leaves margin for a 5 cm drive tolerance.",
        "ref": "drive.driveTo",
        "params": {
         "pose": "park",
         "timeoutSec": 6
        }
       }
      ]
     }
    }
   ]
  }
 }
}
