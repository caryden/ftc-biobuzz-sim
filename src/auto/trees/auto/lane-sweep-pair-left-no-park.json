{
 "kind": "bt.tree",
 "id": "lane-sweep-pair-left-no-park",
 "name": "Lane-sweep pair: left robot, no PARK",
 "env": "onboard",
 "description": "The lane-sweep pair's left robot without the PARK: the robot keeps sweeping the rear spill.",
 "meta": {
  "start": "left",
  "partner": "lane-sweep-pair-right"
 },
 "defs": {
  "full": "bots.me.transfer.full",
  "len": "bots.me.dimensions.length",
  "flip": "if(bots.me.shooter.facing == 'front', 180, 0)",
  "hiveX": "-0.3237",
  "stand": "len / 2 + field.flowerHalfSize + 0.02",
  "rearFlower": "pose(-0.5942, 1.7282 - stand, 90)",
  "angledRear": "pose(hiveX - 0.62, 1.17, 129.4 + flip)"
 },
 "root": {
  "sequence": {
   "children": [
    {
     "id": "s1",
     "ref": "drive.driveTo",
     "params": {
      "pose": "angledRear",
      "timeoutSec": 3
     }
    },
    {
     "id": "s2",
     "note": "The camera wait keeps the robot from launching at the CELL before its partner's TIP raises it.",
     "ref": "waitUntil",
     "params": {
      "condition": "bots.me.vision.seesRaised('rear')",
      "timeoutSec": 8
     }
    },
    {
     "id": "s3",
     "ref": "shooter.shoot",
     "params": {
      "count": 4,
      "timeoutSec": 2.5,
      "cell": "rear"
     }
    },
    {
     "id": "s4",
     "ref": "drive.driveTo",
     "params": {
      "pose": "offset(rearFlower, 0, -0.2)",
      "timeoutSec": 3
     }
    },
    {
     "id": "collect-s5",
     "parallel": {
      "policy": "any",
      "children": [
       {
        "ref": "intake.run",
        "params": {
         "filter": "pollen"
        }
       },
       {
        "sequence": {
         "children": [
          {
           "id": "s5",
           "ref": "drive.driveTo",
           "params": {
            "pose": "rearFlower",
            "timeoutSec": 1.5
           }
          },
          {
           "id": "full-s6",
           "parallel": {
            "policy": "any",
            "children": [
             {
              "ref": "waitUntil",
              "params": {
               "condition": "full"
              }
             },
             {
              "id": "s6",
              "ref": "drive.push",
              "params": {
               "power": 0.35,
               "timeoutSec": 2.2
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    },
    {
     "id": "s7",
     "ref": "drive.driveTo",
     "params": {
      "pose": "angledRear",
      "timeoutSec": 3
     }
    },
    {
     "id": "s8",
     "ref": "shooter.shoot",
     "params": {
      "count": 4,
      "timeoutSec": 2.5
     }
    },
    {
     "id": "s9",
     "note": "That volley tips the rear CELL. The robot watches the TIP and lets the spill reach the rear wall before it sweeps.",
     "ref": "vision.waitTip",
     "params": {
      "cell": "rear",
      "timeoutSec": 4
     }
    },
    {
     "id": "s10",
     "ref": "wait",
     "params": {
      "timeoutSec": 1.2
     }
    },
    {
     "id": "collect-s11",
     "parallel": {
      "policy": "any",
      "children": [
       {
        "ref": "waitUntil",
        "params": {
         "condition": "full"
        }
       },
       {
        "ref": "intake.run",
        "params": {
         "filter": "all"
        }
       },
       {
        "id": "s11",
        "note": "A blind sweep: a TIP spills the CELL where the robot can't see. scripts/plan-sweeps.ts records where the spill comes to rest over many simulated matches and writes the lanes that collect the most. The path ends early once the transfer is full.",
        "ref": "drive.followPath",
        "params": {
         "waypoints": [
          {
           "x": -1.565,
           "y": 1.115,
           "headingDeg": null
          },
          {
           "x": -1.565,
           "y": 0.515,
           "headingDeg": null
          },
          {
           "x": -0.365,
           "y": 1.115,
           "headingDeg": null
          }
         ],
         "timeoutSec": 6.0,
         "tag": "sweep-left"
        }
       }
      ]
     }
    },
    {
     "id": "s12",
     "note": "The right robot's third TIP raises the rear CELL again: launch what the sweep found, then sweep once more so that TELEOP starts with a full transfer.",
     "ref": "drive.driveTo",
     "params": {
      "pose": "angledRear",
      "timeoutSec": 3
     }
    },
    {
     "id": "s13",
     "ref": "shooter.shoot",
     "params": {
      "count": 4,
      "timeoutSec": 4,
      "cell": "rear"
     }
    },
    {
     "id": "collect-s14",
     "parallel": {
      "policy": "any",
      "children": [
       {
        "ref": "waitUntil",
        "params": {
         "condition": "full"
        }
       },
       {
        "ref": "intake.run",
        "params": {
         "filter": "all"
        }
       },
       {
        "id": "s14",
        "note": "A blind sweep: a TIP spills the CELL where the robot can't see. scripts/plan-sweeps.ts records where the spill comes to rest over many simulated matches and writes the lanes that collect the most. The path ends early once the transfer is full.",
        "ref": "drive.followPath",
        "params": {
         "waypoints": [
          {
           "x": -1.565,
           "y": 1.115,
           "headingDeg": null
          },
          {
           "x": -1.565,
           "y": 0.515,
           "headingDeg": null
          },
          {
           "x": -0.365,
           "y": 1.115,
           "headingDeg": null
          }
         ],
         "timeoutSec": 6.0,
         "tag": "sweep-left"
        }
       }
      ]
     }
    }
   ]
  }
 }
}
